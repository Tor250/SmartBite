# Local SQLite is the default. Docker Compose points the backend to Postgres.
DATABASE_URL=sqlite:///./smartbite.db
NEXT_PUBLIC_API_URL=http://localhost:8000
# Create an API key in Google AI Studio and set it here. Never commit a real key.
GEMINI_API_KEY=
SMARTBITE_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Qwen API configuration. A key is region-specific; Singapore's
# international endpoint is the default. Configure Qwen instead of Gemini by
# setting SMARTBITE_GENERATOR_ADAPTER=app.qwen_adapter:create_client.
DASHSCOPE_API_KEY=
SMARTBITE_QWEN_MODEL=qwen3.8-flash
SMARTBITE_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Optional: explicitly select a provider adapter.
# SMARTBITE_GENERATOR_ADAPTER=package.adapter:create_client
