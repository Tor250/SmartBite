# По умолчанию используется локальная SQLite. Docker Compose подключает backend к PostgreSQL.
DATABASE_URL=sqlite:///./smartbite.db
NEXT_PUBLIC_API_URL=http://localhost:8000
SMARTBITE_CORS_ORIGINS=http://localhost:3000
# Создайте API-ключ в Google AI Studio и укажите его здесь. Не добавляйте настоящий ключ в репозиторий.
GEMINI_API_KEY=
SMARTBITE_GEMINI_MODEL=gemini-3.5-flash-lite
# Необязательные параметры API Qwen. Ключ зависит от региона; по умолчанию
# используется международная конечная точка в Сингапуре. Чтобы использовать
# Qwen вместо Gemini, задайте SMARTBITE_GENERATOR_ADAPTER=app.qwen_adapter:create_client.
DASHSCOPE_API_KEY=
SMARTBITE_QWEN_MODEL=qwen3.8-flash
SMARTBITE_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Необязательный параметр: явный выбор адаптера поставщика.
# SMARTBITE_GENERATOR_ADAPTER=package.adapter:create_client
